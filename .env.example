# ------------------------------------------------------------
# Backend (Python)
# Estas variables NO deben exponerse al cliente.
#
# Las llaves de Supabase se obtienen en el dashboard de tu
# proyecto: Project Settings -> API (URL, anon key y
# service_role key).
# ------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ------------------------------------------------------------
# LLM (Z.ai)
# La LLM_API_KEY se entrega en Documentos del SGPA
# (Tecnicos -> Accesos de prueba). Si montas tu propia cuenta,
# se genera en https://z.ai -> API Keys.
# ------------------------------------------------------------
LLM_PROVIDER=zai
LLM_BASE_URL=https://api.z.ai/api/paas/v4/
LLM_API_KEY=tu_llm_api_key_aqui
LLM_MODEL=glm-4.7-flash

# ------------------------------------------------------------
# Frontend (Vite)
# Solo variables con prefijo VITE_ son visibles en el cliente.
# Usa la misma URL y anon key de Supabase que arriba.
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
VITE_API_URL=http://localhost:8000