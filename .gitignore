# ============================================================
# .gitignore — Sistema Inteligente de Optimización de Compras
# ============================================================

# ------------------------------------------------------------
# Secretos y configuración local (CRÍTICO: nunca subir)
# ------------------------------------------------------------
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales
.venv/
venv/
env/
ENV/
.venv*/
.python-version

# Testing / cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# Node / Vue / Vite
# ------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
.vitest/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------
# Editores
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------
# Logs y temporales
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp

# ------------------------------------------------------------
# Datos crudos pesados (descomenta si prefieres no versionarlos)
# ------------------------------------------------------------
# data/raw/*.csv
# data/raw/*.xlsx
# data/seeds/*.csv
# data/seeds/*.xlsx

# ------------------------------------------------------------
# Supabase local (si usas supabase CLI)
# ------------------------------------------------------------
supabase/.branches/
supabase/.temp/